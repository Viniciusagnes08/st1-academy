PORT=4175
ACADEMY_BASE_URL=http://localhost:4175
# Use outro banco para produção. Não transforme o piloto em produção.
ACADEMY_TEST_MODE=1
# Publicação gratuita: Render Free com Supabase PostgreSQL.
# ACADEMY_DEPLOYMENT=production
# ACADEMY_STORAGE=postgres
# DATABASE_URL=postgresql://USUARIO:SENHA@POOLER:5432/postgres
# NODE_EXTRA_CA_CERTS=config/supabase-root-ca.crt
# ACADEMY_AUTH_SECRET=SEGREDO_PRIVADO_ESTAVEL_COM_PELO_MENOS_32_CARACTERES
# ACADEMY_BASE_URL=https://ENDERECO_REAL_DO_SERVICO
# ACADEMY_TEST_MODE=0
# Para hospedar SQLite, use um disco privado permanente em ACADEMY_DATA_DIR.
# ACADEMY_TRUST_PROXY=1
# Preencha no arquivo privado .env ou nas variáveis da hospedagem.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP é usado em convites, recuperação de senha e alertas de segurança.
# Configure no ambiente do servidor ou na área Admin > Integrações do ST1 Academy.
# Links de recuperação duram 30 minutos. Nunca grave senhas ou tokens neste repositório.
# Exemplo para uma caixa Google Workspace: smtp.gmail.com / 465.
# A senha de app não deve ser colocada no repositório.
# ACADEMY_SMTP_HOST=smtp.gmail.com
# ACADEMY_SMTP_PORT=465
# ACADEMY_SMTP_USER=vinicius.agnes@st1.net.br
# ACADEMY_SMTP_PASSWORD=
# ACADEMY_MAIL_FROM=vinicius.agnes@st1.net.br

# Campanhas de WhatsApp: use um número na API oficial e modelos aprovados.
# Mantenha o token apenas no ambiente privado do servidor.
# WHATSAPP_GRAPH_VERSION=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Integrações externas opcionais. Também podem ser salvas cifradas em Admin > Integrações.
# Nenhuma delas participa da transação crítica do Academy.
# GlitchTip: error tracking Sentry-compatible, server-side e sem PII por padrão.
# GLITCHTIP_ENABLED=0
# GLITCHTIP_DSN=
# GLITCHTIP_TRACES_SAMPLE_RATE=0.01

# n8n: webhook HTTPS que recebe eventos persistidos pela Outbox.
# Use um segredo diferente de qualquer senha/token de outros sistemas.
# N8N_ENABLED=0
# N8N_WEBHOOK_URL=https://automation.example.com/webhook/academy
# N8N_WEBHOOK_SECRET=

# OpenPanel: tracking server-side. O Client ID deve ser UUIDv4.
# O navegador do Academy não carrega o SDK do OpenPanel nesta fase.
# OPENPANEL_ENABLED=0
# OPENPANEL_API_URL=https://api.openpanel.dev
# OPENPANEL_CLIENT_ID=
# OPENPANEL_CLIENT_SECRET=
